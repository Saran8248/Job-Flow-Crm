# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# App Environment
NODE_ENV="development"
PORT=3000

# Authentication & Session Security (Generate strong random secrets for production)
# e.g.: openssl rand -base64 32
ADMIN_SECRET_CODE="change_me_to_a_secure_admin_passcode"
STAFF_SECRET_CODE="change_me_to_a_secure_staff_passcode"
PORTAL_SESSION_SECRET="change_me_to_a_random_32_character_string_minimum"

# SMTP Email Configuration (Gmail App Password or SendGrid / Resend)
# NOTE: Never commit live SMTP passwords or production secrets to Git!
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-google-app-password"
SMTP_FROM="JobAssist Portal <noreply@jobassist.com>"

# Security & Debug Flags (Leave false in production)
EXPOSE_DEBUG_OTP="false"
